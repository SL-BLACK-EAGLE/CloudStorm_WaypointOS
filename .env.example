# ─────────────────────────────────────────────────────────────────────────────
# Waypoint Delivery OS · environment template
# Copy to `.env` (repo root). docker compose and apps/web both read it.
# Values marked (local) already work with `docker compose up`.
# ─────────────────────────────────────────────────────────────────────────────

APP_URL=http://localhost:3000
# Business date the demo opens on (seeded peak day). The /demo panel can move the clock.
DEMO_DATE=2025-12-23

# ── Neon Postgres (system of record) ─────────────────────────────────────────
# cloud: Neon pooled connection string   local: postgres container (local)
DATABASE_URL=postgres://waypoint:waypoint@localhost:5432/waypoint
# direct (unpooled) connection for migrations; same as above locally
DATABASE_URL_UNPOOLED=postgres://waypoint:waypoint@localhost:5432/waypoint

# ── Clerk (identity) ─────────────────────────────────────────────────────────
# Create a Clerk *development* instance: https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# Clerk dashboard → Webhooks → endpoint {APP_URL}/api/webhooks/clerk (user.created/updated/deleted)
CLERK_WEBHOOK_SIGNING_SECRET=

# ── Convex (realtime projections + vector index) ─────────────────────────────
# cloud: from `npx convex deploy`      local: self-hosted backend (local)
NEXT_PUBLIC_CONVEX_URL=http://localhost:3210
CONVEX_DEPLOY_KEY=
CONVEX_SELF_HOSTED_URL=http://localhost:3210
CONVEX_SELF_HOSTED_ADMIN_KEY=
# shared secret: Next.js server → Convex internal mutations (any long random string)
CONVEX_SERVER_SECRET=change-me-to-a-long-random-string

# ── Upstash Redis (rate limits, idempotency keys, locks) ─────────────────────
# local: serverless-redis-http container (local)
UPSTASH_REDIS_REST_URL=http://localhost:8079
UPSTASH_REDIS_REST_TOKEN=local-srh-token

# ── Upstash QStash (schedules, outbox relay, notifications) ──────────────────
# local: `qstash dev` container prints these (local)
QSTASH_URL=http://localhost:8080
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# ── Neon Object Storage (S3-compatible: PoD photos, signatures) ──────────────
# local: MinIO container (local)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=waypoint-pod
S3_ACCESS_KEY_ID=waypoint
S3_SECRET_ACCESS_KEY=waypoint-secret
S3_FORCE_PATH_STYLE=true

# ── Neon AI Gateway (deferral explainer + embeddings) ────────────────────────
# optional: without it the app shows the deterministic planner explanation
NEON_AI_GATEWAY_URL=
NEON_AI_GATEWAY_KEY=
AI_CHAT_MODEL=claude-sonnet-5
AI_EMBEDDING_MODEL=

# ── Seed ─────────────────────────────────────────────────────────────────────
# Folder holding the competition CSVs (git-ignored; see seed-data/README.md)
SEED_DATA_DIR=./seed-data

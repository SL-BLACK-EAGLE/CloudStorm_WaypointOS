{
  "name": "cloudstorm-waypointos",
  "private": true,
  "description": "Waypoint Delivery OS - Team CloudStorm, Tech-Triathlon 2026",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "turbo run dev --filter=web",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter e2e test",
    "db:generate": "pnpm --filter @waypoint/db generate",
    "db:migrate": "pnpm --filter @waypoint/db migrate",
    "db:seed": "pnpm --filter @waypoint/db seed",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md,css}\""
  },
  "devDependencies": {
    "prettier": "3.6.2",
    "turbo": "2.11.4",
    "typescript": "5.9.3"
  }
}
